{
  "name": "weather-digest",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "cli": "node src/index.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm test",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "keywords": [
    "weather",
    "cli",
    "nodejs",
    "open-meteo"
  ],
  "author": "",
  "license": "ISC",
  "description": "Console weather digest utility for Open-Meteo API",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.17.0",
    "pg-hstore": "^2.0.6",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "sequelize-cli": "^6.5.5",
    "supertest": "^7.2.2"
  }
}
