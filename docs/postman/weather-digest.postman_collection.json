{
  "info": {
    "name": "Weather Digest Maintenance API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "equipmentId", "value": "" },
    { "key": "requestId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 and data', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.status).to.eql('ok'); });"] } }]
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "Create equipment",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Турбина A-1\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"WT-001\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.61 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2020-01-01T00:00:00.000Z\"\n}" }, "url": "{{baseUrl}}/api/equipment" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('201', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('equipmentId', pm.response.json().data.id);"] } }]
        },
        { "name": "List equipment", "request": { "method": "GET", "url": "{{baseUrl}}/api/equipment?page=1&limit=20" } },
        { "name": "Equipment requests", "request": { "method": "GET", "url": "{{baseUrl}}/api/equipment/{{equipmentId}}/requests" } },
        { "name": "Equipment weather", "request": { "method": "GET", "url": "{{baseUrl}}/api/equipment/{{equipmentId}}/weather" } },
        { "name": "Duplicate serial (409)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Duplicate\",\"type\":\"sensor\",\"serialNumber\":\"WT-001\",\"location\":{\"lat\":1,\"lon\":1},\"status\":\"operational\",\"installedAt\":\"2020-01-01\"}" }, "url": "{{baseUrl}}/api/equipment" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('409', function () { pm.response.to.have.status(409); });"] } }] }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "Create request",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"title\": \"Заменить датчик\",\n  \"priority\": \"high\"\n}" }, "url": "{{baseUrl}}/api/requests" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('201', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('requestId', pm.response.json().data.id);"] } }]
        },
        { "name": "List requests", "request": { "method": "GET", "url": "{{baseUrl}}/api/requests?status=new&page=1&limit=20" } },
        { "name": "Invalid status transition (409)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"done\"}" }, "url": "{{baseUrl}}/api/requests/{{requestId}}/status" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('409', function () { pm.response.to.have.status(409); });"] } }] },
        { "name": "Move to in progress", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"in_progress\"}" }, "url": "{{baseUrl}}/api/requests/{{requestId}}/status" } },
        { "name": "Unknown request (404)", "request": { "method": "GET", "url": "{{baseUrl}}/api/requests/00000000-0000-4000-8000-000000000000" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('404', function () { pm.response.to.have.status(404); });"] } }] }
      ]
    }
  ]
}
