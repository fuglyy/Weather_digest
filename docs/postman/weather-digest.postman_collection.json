{
  "info": {
    "name": "Weather Digest Maintenance API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost" },
    { "key": "authEmail", "value": "" },
    { "key": "authPassword", "value": "ChangeMe-Postman-2026!" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "viewerAccessToken", "value": "" },
    { "key": "technicianAccessToken", "value": "" },
    { "key": "technicianPassword", "value": "ChangeMe-Tech-2026!" },
    { "key": "accessToken", "value": "" },
    { "key": "equipmentId", "value": "" },
    { "key": "equipmentSerial", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "unassignedRequestId", "value": "" },
    { "key": "leadTechnicianId", "value": "" },
    { "key": "leadTechnicianEmail", "value": "" },
    { "key": "memberTechnicianId", "value": "" },
    { "key": "memberTechnicianEmail", "value": "" },
    { "key": "siteId", "value": "11111111-1111-4111-8111-111111111111" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register demo user",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('authEmail', pm.variables.replaceIn('postman-{{$guid}}@example.com'));"] } },
            { "listen": "test", "script": { "exec": ["pm.test('201 viewer user has no password fields', function () { pm.response.to.have.status(201); var user = pm.response.json().data.user; pm.expect(user.email).to.eql(pm.collectionVariables.get('authEmail')); pm.expect(user.role).to.eql('viewer'); pm.expect(user).not.to.have.property('passwordHash'); pm.expect(user).not.to.have.property('passwordSalt'); });"] } }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\",\n  \"role\": \"admin\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login as viewer",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 viewer access token issued', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.user.role).to.eql('viewer'); });", "pm.collectionVariables.set('viewerAccessToken', pm.response.json().data.accessToken);"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Viewer cannot create equipment (403)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403 insufficient role', function () { pm.response.to.have.status(403); });"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{viewerAccessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/equipment"
          }
        },
        {
          "name": "Login as bootstrap admin",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 admin access token issued', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.user.role).to.eql('admin'); });", "pm.collectionVariables.set('accessToken', pm.response.json().data.accessToken);"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Current user",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 admin user', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.user.role).to.eql('admin'); });"] } }]
        },
        {
          "name": "Refresh access token",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 and refreshed access token issued', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.accessToken).to.be.a('string'); });", "pm.collectionVariables.set('accessToken', pm.response.json().data.accessToken);"] } }],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/refresh" }
        }
      ]
    },
    {
      "name": "Provision technicians",
      "item": [
        {
          "name": "Create lead technician",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('leadTechnicianId', pm.variables.replaceIn('{{$guid}}'));", "pm.collectionVariables.set('leadTechnicianEmail', pm.variables.replaceIn('lead-{{$guid}}@example.com'));"] } },
            { "listen": "test", "script": { "exec": ["pm.test('201 lead technician created', function () { pm.response.to.have.status(201); pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('leadTechnicianId')); });"] } }
          ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"id\": \"{{leadTechnicianId}}\",\n  \"fullName\": \"Demo Lead Technician\",\n  \"specialization\": \"mechanics\",\n  \"personnelNumber\": \"POSTMAN-LEAD-{{leadTechnicianId}}\"\n}" }, "url": "{{baseUrl}}/api/technicians" }
        },
        {
          "name": "Create lead technician account",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 technician account linked to technician id', function () { pm.response.to.have.status(201); pm.expect(pm.response.json().data.user.id).to.eql(pm.collectionVariables.get('leadTechnicianId')); pm.expect(pm.response.json().data.user.role).to.eql('technician'); });"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{leadTechnicianEmail}}\",\n  \"password\": \"{{technicianPassword}}\",\n  \"role\": \"technician\",\n  \"technicianId\": \"{{leadTechnicianId}}\"\n}" }, "url": "{{baseUrl}}/api/auth/users" }
        },
        {
          "name": "Create member technician",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('memberTechnicianId', pm.variables.replaceIn('{{$guid}}'));", "pm.collectionVariables.set('memberTechnicianEmail', pm.variables.replaceIn('member-{{$guid}}@example.com'));"] } }
          ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"id\": \"{{memberTechnicianId}}\",\n  \"fullName\": \"Demo Member Technician\",\n  \"specialization\": \"electrics\",\n  \"personnelNumber\": \"POSTMAN-MEMBER-{{memberTechnicianId}}\"\n}" }, "url": "{{baseUrl}}/api/technicians" }
        },
        {
          "name": "Create member technician account",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{memberTechnicianEmail}}\",\n  \"password\": \"{{technicianPassword}}\",\n  \"role\": \"technician\",\n  \"technicianId\": \"{{memberTechnicianId}}\"\n}" }, "url": "{{baseUrl}}/api/auth/users" }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 and data', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.status).to.eql('ok'); });"] } }] },
        { "name": "Liveness", "request": { "method": "GET", "url": "{{baseUrl}}/api/health/live" } },
        { "name": "Readiness", "request": { "method": "GET", "url": "{{baseUrl}}/api/health/ready" } }
      ]
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "Create equipment",
          "event": [{ "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('equipmentSerial', pm.variables.replaceIn('WT-{{$guid}}'));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Турбина A-1\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"{{equipmentSerial}}\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.61 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2020-01-01T00:00:00.000Z\"\n}" }, "url": "{{baseUrl}}/api/equipment" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('201', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('equipmentId', pm.response.json().data.id);"] } }]
        },
        { "name": "List equipment", "request": { "method": "GET", "url": "{{baseUrl}}/api/equipment?page=1&limit=20" } },
        { "name": "List equipment (filtered/sorted)", "request": { "method": "GET", "url": "{{baseUrl}}/api/equipment?type=turbine&status=operational&sortBy=name&order=asc&page=1&limit=10" } },
        { "name": "Equipment requests", "request": { "method": "GET", "url": "{{baseUrl}}/api/equipment/{{equipmentId}}/requests" } },
        { "name": "Equipment weather", "request": { "method": "GET", "url": "{{baseUrl}}/api/equipment/{{equipmentId}}/weather" } },
        { "name": "Duplicate serial (409)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Duplicate\",\"type\":\"sensor\",\"serialNumber\":\"{{equipmentSerial}}\",\"location\":{\"lat\":1,\"lon\":1},\"status\":\"operational\",\"installedAt\":\"2020-01-01\"}" }, "url": "{{baseUrl}}/api/equipment" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('409', function () { pm.response.to.have.status(409); });"] } }] }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "Create request",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"title\": \"Заменить датчик\",\n  \"priority\": \"high\"\n}" }, "url": "{{baseUrl}}/api/requests" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('201', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('requestId', pm.response.json().data.id);"] } }]
        },
        { "name": "List requests", "request": { "method": "GET", "url": "{{baseUrl}}/api/requests?status=new&page=1&limit=20" } },
        { "name": "List requests (filtered/sorted)", "request": { "method": "GET", "url": "{{baseUrl}}/api/requests?priority=high&sortBy=createdAt&order=desc&page=1&limit=10" } },
        { "name": "Invalid status transition (409)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"done\"}" }, "url": "{{baseUrl}}/api/requests/{{requestId}}/status" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('409', function () { pm.response.to.have.status(409); });"] } }] },
        { "name": "Assign technicians", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"assignees\": [\n    { \"userId\": \"{{leadTechnicianId}}\", \"role\": \"lead\", \"hours\": 2 },\n    { \"userId\": \"{{memberTechnicianId}}\", \"role\": \"member\", \"hours\": 1 }\n  ]\n}" }, "url": "{{baseUrl}}/api/requests/{{requestId}}/assignees" } },
        { "name": "Move to in progress", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"in_progress\"}" }, "url": "{{baseUrl}}/api/requests/{{requestId}}/status" } },
        {
          "name": "Login as assigned technician",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 technician login', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.user.role).to.eql('technician'); });", "pm.collectionVariables.set('technicianAccessToken', pm.response.json().data.accessToken);"] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{leadTechnicianEmail}}\",\n  \"password\": \"{{technicianPassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "Assigned technician completes request",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 assigned technician may change status', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.status).to.eql('done'); });"] } }],
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{technicianAccessToken}}", "type": "string" }] }, "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"done\"}" }, "url": "{{baseUrl}}/api/requests/{{requestId}}/status" }
        },
        {
          "name": "Create unassigned request",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 unassigned request created', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('unassignedRequestId', pm.response.json().data.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"title\": \"Unassigned access check\",\n  \"priority\": \"low\"\n}" }, "url": "{{baseUrl}}/api/requests" }
        },
        {
          "name": "Technician cannot change unassigned request (403)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403 technician is not assigned', function () { pm.response.to.have.status(403); });"] } }],
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{technicianAccessToken}}", "type": "string" }] }, "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"in_progress\"}" }, "url": "{{baseUrl}}/api/requests/{{unassignedRequestId}}/status" }
        },
        { "name": "Request status history", "request": { "method": "GET", "url": "{{baseUrl}}/api/requests/{{requestId}}/history" } },
        { "name": "Unknown request (404)", "request": { "method": "GET", "url": "{{baseUrl}}/api/requests/00000000-0000-4000-8000-000000000000" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('404', function () { pm.response.to.have.status(404); });"] } }] }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        { "name": "Site summary", "request": { "method": "GET", "url": "{{baseUrl}}/api/sites/{{siteId}}/summary" } },
        { "name": "Equipment load (month)", "request": { "method": "GET", "url": "{{baseUrl}}/api/reports/equipment-load?period=month&minRequests=1&siteId={{siteId}}" } }
      ]
    },
    {
      "name": "Logout",
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('204 session ended', function () { pm.response.to.have.status(204); });", "pm.collectionVariables.unset('accessToken');"] } }],
      "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
    }
  ]
}
